#!/bin/sh
# Valida a autoria de todos os commits que estão sendo enviados.
root=$(git rev-parse --show-toplevel)
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac # branch sendo apagada
  case "$remote_sha" in
    *[!0]*) range="$remote_sha..$local_sha" ;;
    *) range="$local_sha --not --remotes" ;;
  esac
  # remoto avançou e ainda não foi buscado: checa tudo que não está em nenhum remoto
  git cat-file -e "$remote_sha" 2>/dev/null || range="$local_sha --not --remotes"
  sh "$root/scripts/check-authorship.sh" $range || status=1
done
exit $status
